[Unit]
Description=University Result Portal (example)
After=network.target

[Service]
User=portal
Group=portal
WorkingDirectory=/opt/university-portal
ExecStart=/opt/university-portal/venv/bin/gunicorn --bind 127.0.0.1:8000 app:app
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
